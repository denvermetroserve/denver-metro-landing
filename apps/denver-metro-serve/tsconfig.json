{
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": false,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "preserve",
		"incremental": true,
		"plugins": [{ "name": "next" }],
		"baseUrl": ".",
		"paths": {
			"@/*": ["../../src/*"],
			"@external/dynamic-hero": [
				"../../src/components/dynamic-hero/src/index.ts"
			],
			"@external/dynamic-hero/*": ["../../src/components/dynamic-hero/src/*"],
			"@external/use-exit-intent": [
				"../../external/use-exit-intent-remastered/packages/use-exit-intent/src/index.ts"
			],
			"@external/use-exit-intent/*": [
				"../../external/use-exit-intent-remastered/packages/use-exit-intent/src/*"
			]
		}
	},
	"include": ["next-env.d.ts", ".next/types/**/*.ts", "**/*.ts", "**/*.tsx"],
	"exclude": ["node_modules"]
}
